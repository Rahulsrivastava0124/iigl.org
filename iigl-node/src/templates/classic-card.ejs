<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>IIGL Classic Card</title>
<style>
  /*
    The classic card, as `classic2.blade.php` prints it.

    This document is **overprinting**. The card is pre-printed stock — the
    letterhead, the border, the grading artwork and the IIGL marks are already
    on the card before it goes into the printer — so what is rendered here is
    the certificate's own data and nothing else, positioned to land in the
    blank areas of that stock. That is why there is no logo, no watermark and
    no rule anywhere below: printing one would put a second letterhead on top of
    the one already there.

    The page is 280mm x 213mm, the size of the stock, and the two columns are
    absolutely placed at the measurements the blade uses. Nothing here is a
    layout decision; every number is the one the card is already printed to.
  */
  @page {
    size: 280mm 213mm;
    margin: 0;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: #fff;
    /* Bootstrap's body colour, which is what the blade inherits. */
    color: #212529;
    font-family: Roboto, Arial, Helvetica, sans-serif;
  }

  .page {
    position: relative;
    width: 280mm;
    height: 213mm;
    overflow: hidden;
    page-break-after: always;
  }
  .page:last-child { page-break-after: auto; }

  /* The left column: what the stone is. */
  .col-data {
    position: absolute;
    top: 0;
    left: 0;
    width: 93.5mm;
    height: 213mm;
    padding: 48mm 10mm 30mm 10mm;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }

  /* The right column: the stone, the way to verify it, and who signed it. */
  .col-proof {
    position: absolute;
    top: 0;
    left: 93.5mm;
    width: 93.5mm;
    height: 213mm;
    padding: 47mm 10mm 25mm 10mm;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }

  .block { width: 100%; margin: 0; padding: 0; }

  .row {
    display: flex;
    font-size: 15px;
    font-weight: 500;
  }
  .row .label { width: 30mm; }
  .row .value { width: auto; }

  /*
    An attribute row is lower-cased and then capitalised, which is what the
    blade's `.capti` does — and it does it to the whole row, not just the label.
    The catalogue holds both shouted: REFRCT INDEX, and TRASPARENT NO INCLUSION
    for its value. The card prints them as words on both sides of the colon.
  */
  .row.attribute { text-transform: capitalize; }

  .col-proof .row {
    display: block;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }

  .comment-title {
    margin: 3mm 0 0;
    font-weight: bold;
    color: #4d423f;
    text-align: center;
  }
  .comment-body {
    margin-bottom: 0;
    text-transform: capitalize;
    font-weight: bold;
    color: #3f425c;
    text-align: center;
  }

  .stone { width: 200px; height: 200px; margin-top: 3mm; object-fit: contain; }
  .qr-title { margin: 3mm 0 0; font-weight: bold; color: #31408f; }
  .qr { width: 100px; height: 100px; }
  .sign { height: 40px; width: 80px; margin-top: 3mm; }
</style>
</head>
<body>
<% for (const card of cards) { %>
  <div class="page">

    <div class="col-data">
      <div class="block">
        <div class="row"><div class="label">Dated on</div><div class="value">: <%= card.issued_on_ddmmyyyy %></div></div>
      </div>

      <div class="block">
        <div class="row"><div class="label">Report ID No.</div><div class="value">: <b><%= card.report_no %></b></div></div>
      </div>

      <% /* Left off when the certificate records none — see `measured`. */ %>
      <% if (card.gross_weight) { %>
        <div class="block">
          <div class="row">
            <div class="label">Gross Weight</div>
            <div class="value">: <%= card.gross_weight %><%= card.gross_wt_unit ? ' ' + card.gross_wt_unit : '' %><%= card.is_approx ? ' apx.' : '' %></div>
          </div>
        </div>
      <% } %>

      <div class="block">
        <div class="row">
          <div class="label">Carat Weight</div>
          <div class="value">: <%= card.carat_weight %><%= card.stone_wt_unit ? ' ' + card.stone_wt_unit : '' %></div>
        </div>
      </div>

      <% if (card.size) { %>
        <div class="block">
          <div class="row"><div class="label">Measurement</div><div class="value">: <%= card.size %></div></div>
        </div>
      <% } %>

      <% for (const attr of card.classic_attributes) { %>
        <div class="block">
          <div class="row attribute">
            <div class="label"><%= attr.name.toLowerCase() %></div>
            <div class="value">: <%= attr.value %></div>
          </div>
        </div>
      <% } %>

      <div class="block">
        <div class="row" style="display: block">
          <h5 class="comment-title">Comment</h5>
          <p class="comment-body"><%= card.comments %></p>
        </div>
      </div>
    </div>

    <div class="col-proof">
      <%
        /* `GRADING SCALES` is in the blade and `display:none` in both screen
           and print, because the scales are printed on the stock. Not carried
           over: a heading that is never shown is a heading nobody maintains. */
      %>
      <div class="block">
        <div class="row">
          <% if (card.item_image) { %><img class="stone" src="<%= card.item_image %>" alt=""><% } %>
        </div>
      </div>

      <div class="block">
        <div class="row">
          <h5 class="qr-title">Online QR Code</h5>
          <img class="qr" src="<%= card.qr %>" alt="Verify <%= card.report_no %>">
        </div>
      </div>

      <div class="block">
        <div class="row">
          <% if (card.signature) { %><img class="sign" src="<%= card.signature %>" alt=""><% } %>
        </div>
      </div>
    </div>

  </div>
<% } %>
</body>
</html>
