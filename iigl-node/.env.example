# ---------------------------------------------------------------- database
# The existing MySQL database, shared with the Laravel application.
# This service never alters schema: grant SELECT, INSERT, UPDATE, DELETE
# and nothing more.
DATABASE_URL="mysql://user:password@localhost:3306/iigl"

# ------------------------------------------------------------------ server
PORT=3000

# Signs session cookies. The cookie carries the signed-in user itself, so the
# signature is the whole of the authentication: must be 32+ random characters,
# and startup refuses to run under NODE_ENV=production with a placeholder or a
# short value, because a guessable secret means a forgeable session. Changing
# it signs everyone out, which is also how you revoke every session at once.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# ------------------------------------------------------------------- links
# Origin that printed QR codes resolve against. Certificates already in
# circulation point at PUBLIC_SITE_URL/verify-report/{id}, so changing this
# does not change what is already printed.
PUBLIC_SITE_URL=https://www.iigl.org

# The Laravel public/ directory, which still holds the card logos and every
# uploaded item image and signature. Cards read from it until those assets
# are moved into this project.
LEGACY_PUBLIC_ROOT=../../iigl.org_old/iigl.org/public

# ------------------------------------------------------------------- email
# Where the admin panel is served from. Password reset links point here, so it
# must be the address people actually open, not the API's.
PANEL_URL=http://localhost:5173

# SMTP connection string for the password reset mail, e.g.
#   smtps://user:pass@smtp.example.com:465
# Leave blank and there is no mail: the reset link is logged to the server
# console in development, and refused outright under NODE_ENV=production,
# rather than reporting a success to someone who will never receive anything.
SMTP_URL=
MAIL_FROM=IIGL <no-reply@iigl.org>

# -------------------------------------------------------------------- CORS
# Browser origins allowed to call this API, comma separated. Authentication is
# a cookie, so this is an explicit allowlist: a wildcard cannot be combined
# with credentials, and reflecting whatever Origin arrives would let any site
# call the API with a visitor's session.
#
# Include every address the admin panel is served from:
#   http://localhost:5173,https://admin.iigl.org,https://super.iigl.org,https://team.iigl.org
#
# Not needed when the panel is served from this same host.
CORS_ORIGINS=http://localhost:5173
