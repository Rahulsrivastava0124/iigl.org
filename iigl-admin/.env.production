# The values this panel is built with. Committed on purpose — see .gitignore.
#
# Read at build time: Vite substitutes them into the bundle, so changing one
# means a rebuild, not a restart. A build argument of the same name overrides
# what is here, which is the escape hatch for a one-off build.

# Where the panel finds the API.
#
# The /api suffix is part of it: the API mounts its routes at /api
# (iigl-node/src/app.ts), so the base has to include it.
#
# This is a different origin from the panel, which has two consequences on the
# API side, both required or sign-in fails in ways that look like other bugs:
#
#   CORS_ORIGINS         must list this panel's origin. Without it the browser
#                        blocks every response.
#   SESSION_CROSS_SITE   must be true. The session is an httpOnly cookie, and a
#                        SameSite=Lax cookie is not sent cross-site at all — the
#                        login succeeds and every request after it is anonymous.
VITE_API_URL=https://api.iigl.org/api

# ---------------------------------------------------------------------------
# Uploads. Pictures are shrunk in the browser before they are sent; all four are
# clamped in src/lib/image.ts, so a typo falls back to the default rather than
# ruining a week of scans. Commented out means the default applies.
# ---------------------------------------------------------------------------

# JPEG/WebP quality, 0.4-1.
# VITE_IMAGE_QUALITY=0.82

# Longest edge in pixels, 600-6000.
# VITE_IMAGE_MAX_EDGE=2000

# Leave anything smaller than this alone, in KB, 0-5000.
# VITE_IMAGE_SKIP_UNDER_KB=300

# Largest picture somebody may choose, in MB, 8-128 — before shrinking.
# VITE_UPLOAD_MAX_MB=32
