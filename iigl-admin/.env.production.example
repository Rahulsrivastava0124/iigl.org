# Copy to .env.production for a build served from the same host as the API.
VITE_API_URL=/api

# Or, when the API is on its own host:
# VITE_API_URL=https://api.iigl.org/api

# ---------------------------------------------------------------------------
# Uploads
#
# Pictures are shrunk in the browser before they are sent. Clamped in
# src/lib/image.ts, so a typo falls back rather than ruining a week of scans.
# Baked into the bundle at build time.
# ---------------------------------------------------------------------------

# JPEG/WebP quality, 0.4–1.
# VITE_IMAGE_QUALITY=0.82

# Longest edge in pixels, 600–6000.
# VITE_IMAGE_MAX_EDGE=2000

# Leave anything smaller than this alone, in KB, 0–5000.
# VITE_IMAGE_SKIP_UNDER_KB=300

# Largest picture somebody may choose, in MB, 8–128 — before shrinking.
# VITE_UPLOAD_MAX_MB=32
