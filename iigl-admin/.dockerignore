# .env.production is NOT excluded, deliberately. It is how the build learns
# which API to talk to, and it is committed for that reason — see .gitignore.
# Everything in it reaches the browser anyway.
#
# .env is excluded: that one is a developer's machine, and its VITE_DEV_ values
# are meaningless in an image. Vite reads both in production mode, so leaving it
# in would let a laptop's settings shadow the deployed ones.
.env
.env.local
.env.*.local

# Rebuilt inside the image, and copying them in would bust the layer cache on
# every change.
node_modules
dist

.git
.gitignore
.DS_Store
*.log
Dockerfile
.dockerignore
