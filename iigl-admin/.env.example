# Where the panel finds the API.
#
#   /api                      same origin (default). In development Vite proxies
#                             this to VITE_DEV_API_TARGET below; in production
#                             the panel and the API sit behind one host.
#
#   https://api.iigl.org/api  a different origin. That API must list this
#                             panel's origin in its CORS_ORIGINS, and both sides
#                             must be HTTPS, or the browser drops the session
#                             cookie.
#
# Read at build time, so changing it means rebuilding.
VITE_API_URL=/api

# Development only: where Vite forwards /api. Ignored in a production build.
VITE_DEV_API_TARGET=http://localhost:3000

# Development only: the port this panel serves on.
VITE_DEV_PORT=5173

# ---------------------------------------------------------------------------
# Uploads
#
# Pictures are shrunk in the browser before they are sent: a phone photograph
# of an Aadhaar card is four megabytes of a document that prints at 3cm across.
# These decide how hard. All are optional and all are clamped to a range that
# still produces a readable document, so a typo cannot ruin a week of scans.
#
# Read at build time, like every VITE_ value — changing one means rebuilding.
# ---------------------------------------------------------------------------

# JPEG/WebP quality, 0.4–1. Lower is smaller and softer.
# VITE_IMAGE_QUALITY=0.82

# Longest edge in pixels, 600–6000. Raise it where certificates carry fine
# detail; 2000 is already more than an A4 page needs at print resolution.
# VITE_IMAGE_MAX_EDGE=2000

# Leave anything smaller than this alone, in KB, 0–5000. A re-encode always
# loses a little, so there is no point shrinking what is already small.
# VITE_IMAGE_SKIP_UNDER_KB=300

# The largest picture somebody may choose, in MB, 8–128 — before shrinking,
# which is why it is far above the API's own 8 MB ceiling on what arrives.
# VITE_UPLOAD_MAX_MB=32
