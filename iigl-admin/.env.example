# Where the panel finds the API.
#
#   /api                      same origin (default). In development Vite proxies
#                             this to VITE_DEV_API_TARGET below; in production
#                             the panel and the API sit behind one host.
#
#   https://api.iigl.org/api  a different origin. That API must list this
#                             panel's origin in its CORS_ORIGINS, and both sides
#                             must be HTTPS, or the browser drops the session
#                             cookie.
#
# Read at build time, so changing it means rebuilding.
VITE_API_URL=/api

# Development only: where Vite forwards /api. Ignored in a production build.
VITE_DEV_API_TARGET=http://localhost:3000

# Development only: the port this panel serves on.
VITE_DEV_PORT=5173
